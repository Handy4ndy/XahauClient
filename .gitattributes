# Auto detect text files; normalize line endings
* text=auto

# Source / docs - LF in repo
*.ino text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.cc text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf
*.properties text eol=lf
*.py text eol=lf
*.rb text eol=lf
*.sh text eol=lf
*.cmake text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows scripts keep CRLF if needed
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.bin binary
*.elf binary
*.a binary
*.o binary
*.exe binary
*.zip binary
*.gz binary
*.hex binary
